{
	"license": "UNLICENSED",
	"type": "module",
	"private": true,
	"scripts": {
		"prepare": "husky",
		"pre-commit": "lint-staged",
		"pre-push": "concurrently --group --timings pnpm:check pnpm:lint pnpm:test:unit pnpm:test:integration",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"plop": "plop",
		"update-theme": "figma2theme generate-tailwind && prettier --write ./tailwind.figma2theme.js",
		"test": "pnpm test:integration && pnpm test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test:unit:ui": "vitest --ui",
		"test:unit:watch": "vitest",
		"test:integration": "playwright test",
		"test:integration:ui": "playwright test --ui",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test-storybook": "test-storybook --index-json"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/js": "^9.39.5",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/roboto-mono": "^5.3.0",
		"@playwright/test": "^1.64.1",
		"@storybook/addon-a11y": "^8.6.19",
		"@storybook/addon-essentials": "^8.6.19",
		"@storybook/addon-interactions": "^8.6.19",
		"@storybook/addon-links": "^8.6.19",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/blocks": "^8.6.19",
		"@storybook/svelte": "^8.6.19",
		"@storybook/sveltekit": "^8.6.19",
		"@storybook/test": "^8.6.19",
		"@storybook/test-runner": "^0.22.1",
		"@sveltejs/adapter-auto": "^6.1.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/eslint": "^8.56.12",
		"@vitest/ui": "^4.1.12",
		"autoprefixer": "^10.6.2",
		"bits-ui": "^0.22.0",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.6",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^9.1.2",
		"eslint-plugin-svelte": "^3.24.0",
		"figma2theme": "^0.9.3",
		"globals": "^15.15.0",
		"http-server": "^14.1.1",
		"husky": "^9.1.7",
		"jsdom": "^30.1.3",
		"lint-staged": "^17.6.0",
		"plop": "^4.0.5",
		"postcss": "^8.5.32",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"storybook": "^8.6.19",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwind-merge": "^2.6.1",
		"tailwind-variants": "^0.3.1",
		"tailwindcss": "^3.4.19",
		"tslib": "^2.9.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^6.4.5",
		"vitest": "^4.1.12",
		"wait-on": "^9.5.1"
	},
	"packageManager": "pnpm@11.28.10",
	"engines": {
		"node": ">=22",
		"pnpm": ">=11"
	}
}
