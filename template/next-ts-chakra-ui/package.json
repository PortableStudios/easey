{
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "pre-push": "concurrently --group pnpm:typecheck pnpm:test",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "plop": "plop",
    "update-theme": "figma2theme generate-chakra -o ./src/theme/_generated",
    "verify": "concurrently --group pnpm:test pnpm:lint pnpm:typecheck",
    "lint": "eslint --fix .",
    "typecheck": "concurrently --group pnpm:typecheck:*",
    "typecheck:app": "tsc -p ./tsconfig.json --noEmit",
    "typecheck:cypress": "tsc -p ./cypress/tsconfig.json --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "screenshots": "rimraf __screenshots__ && storycap http://localhost:6006 --flat",
    "analyze": "cross-env ANALYZE=true pnpm build",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:coverage:open": "pnpm test:coverage && open ./coverage/lcov-report/index.html",
    "test:debug": "node --inspect-brk node_modules/jest/bin/jest.js --runInBand",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run"
  },
  "dependencies": {
    "@chakra-ui/icon": "^3.0.2",
    "@chakra-ui/react": "^2.10.10",
    "@chakra-ui/theme-tools": "^2.0.2",
    "@emotion/react": "^11.9.3",
    "@emotion/styled": "^11.9.3",
    "@next/bundle-analyzer": "^15.5.29",
    "@sentry/nextjs": "^10.78.0",
    "@types/gtag.js": "^0.0.10",
    "@types/smoothscroll-polyfill": "^0.3.1",
    "framer-motion": "^11.18.2",
    "next": "^15.5.29",
    "polished": "^4.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "smoothscroll-polyfill": "^0.4.4"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.6.19",
    "@storybook/addon-designs": "^8.2.1",
    "@storybook/addon-essentials": "^8.6.19",
    "@storybook/addon-links": "^8.6.19",
    "@storybook/addon-storysource": "^8.6.19",
    "@storybook/addon-viewport": "^8.6.19",
    "@storybook/blocks": "^8.6.19",
    "@storybook/nextjs": "^8.6.19",
    "@storybook/react": "^8.6.19",
    "@storybook/theming": "^8.6.19",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "axe-core": "^4.4.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "cypress": "^15.21.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-cypress": "^3.6.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-storybook": "^0.12.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "figma2theme": "^0.9.3",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-watch-typeahead": "^3.0.1",
    "lint-staged": "^17.6.0",
    "plop": "^4.0.5",
    "prettier": "^2.7.0",
    "rimraf": "^6.1.4",
    "storybook": "^8.6.19",
    "storycap": "^5.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webpack": "~5.100.2"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.28.10"
}
